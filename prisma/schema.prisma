
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int    @id @default(autoincrement())
  email     String @unique @db.VarChar(100)
  password  String @db.VarChar(255)
  firstName String @db.VarChar(50)
  lastName  String @db.VarChar(50)
  age       Int?
  height    Int? // in cm
  weight    Int? // in kg

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  workouts  Workout[]

  @@map("users")
}

model Exercise {
  id            Int         @id @default(autoincrement())
  name          String      @unique @db.VarChar(100)
  description   String      @db.VarChar(255)
  muscularGroup MuscleGroup
  difficulty    Difficulty
  category      Category
  equipment     Equipment[]

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  
  routines  RoutineExercise[]
  workoutExercises  WorkoutExerciseLog[]

  @@map("exercises")
}

model Routine {
  id            Int        @id @default(autoincrement())
  name          String     @unique @db.VarChar(100)
  description   String     @db.VarChar(255)
  aproxDuration Int        @default(60) // in minutes
  difficulty    Difficulty
  category      Category

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  exercises RoutineExercise[]
  workouts Workout[]

  @@map("routines")
}

model RoutineExercise {
  id            Int @id @default(autoincrement())
  routineId     Int
  exerciseId    Int
  rest          Int @default(180) // in seconds
  setsPlanned   Int @default(3)
  repsPlanned   Int @default(10)
  weightPlanned Int @default(0) // in kg

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routine  Routine  @relation(fields: [routineId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([routineId, exerciseId])
  @@map("routine_exercises")
}

model Workout {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  description String @db.VarChar(255)
  userId    Int
  routineId Int
  date      DateTime @default(now())
  durationRegistered  Int      @default(60) // in minutes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  routine Routine @relation(fields: [routineId], references: [id])

  exercises WorkoutExerciseLog[]
  @@map("workouts")
}

model WorkoutExerciseLog {
  id              Int      @id @default(autoincrement())
  workoutId       Int
  exerciseId      Int

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workout    Workout  @relation(fields: [workoutId], references: [id])
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  setsLogs SetLog[]

  @@unique([workoutId, exerciseId])
  @@map("workout_exercises")
}

model SetLog {
  id                Int      @id @default(autoincrement())
  workoutExerciseId Int
  setNumber         Int
  reps              Int
  weight            Int

  createdAt         DateTime @default(now())
  workoutExercise   WorkoutExerciseLog @relation(fields: [workoutExerciseId], references: [id])

  @@map("workout_exercise_sets")
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  CORE
  GLUTES
  QUADRICEPS
  HAMSTRINGS
  CALVES
  FULL_BODY
}

enum Category {
  STRENGTH
  CARDIO
  FLEXIBILITY
  BALANCE
  ENDURANCE
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum Equipment {
  DUMBBELLS
  BARBELL
  KETTLEBELL
  RESISTANCE_BANDS
  BODYWEIGHT
  MACHINES
  MEDICINE_BALL
  BOSU_BALL
  YOGA_MAT
}
